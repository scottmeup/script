# Inputs: configuration entries consumed by build-dropbear-cronos-bootstrap.sh and prepare-dropbear-sftp-candidate-local.sh.
# Outputs: none directly; values select pinned downloads, build paths, Echo paths, ports, and the compiled root PATH.
# Structure: POSIX shell assignments. Copy to dropbear-cronos-bootstrap.env and adjust only if the defaults do not match the target.
BUILD_ROOT=/mnt/mp0/build-dropbear-android
ANDROID_NDK_VERSION=r29
ANDROID_NDK_URL=https://dl.google.com/android/repository/android-ndk-r29-linux.zip
ANDROID_NDK_SHA1=87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b
ANDROID_API=24
ANDROID_TARGET=armv7a-linux-androideabi
ANDROID_DROPBEAR_REPOSITORY=https://github.com/ribbons/android-dropbear.git
ANDROID_DROPBEAR_REF=DROPBEAR_2026.94
DROPBEAR_UPSTREAM_COMMIT=28216cd
DROPBEAR_VERSION=2026.94
DROPBEAR_SOURCE_URL=https://matt.ucc.asn.au/dropbear/releases/dropbear-2026.94.tar.bz2
DROPBEAR_SOURCE_SHA256=e098034a843699200c8c977a991fff73159735bf795d5f72ef672c41a6b1ae81
DEFAULT_ROOT_PATH=/sbin:/system/sbin:/system/bin:/system/xbin:/vendor/bin:/vendor/xbin:/data/adb/magisk:/data/local/bin:/dev/script:/dev/user-script:/data/data/com.termux/files/usr/bin
SFTP_WRAPPER=/data/local/bin/dropbear-sftp-server
ECHO_HOST=192.168.1.117
CANDIDATE_PORT=2222
FINAL_PORT=22
SSH_KEY_PATH=$HOME/.ssh/id_rsa
