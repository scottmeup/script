# ROOT_PATH may be absolute or relative to Search-DirectoryText.ps1.
ROOT_PATH=C:\Path\To\Directory

# Include hidden files and directories in the tree and search.
INCLUDE_HIDDEN=false

# Separator used by EXCLUDE_DIRECTORIES and EXCLUDE_EXTENSIONS.
LIST_SEPARATOR=|

# Directory names to skip anywhere in the tree.
EXCLUDE_DIRECTORIES=.git|node_modules|bin|obj

# Extensions to skip. Entries may be written with or without the leading dot.
EXCLUDE_EXTENSIONS=.exe|.dll|.zip|.png|.jpg|.jpeg|.gif|.pdf

# Leave empty to disable CSV output.
OUTPUT_CSV=search-results.csv
