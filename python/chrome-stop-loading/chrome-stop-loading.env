# Inputs: loopback CDP endpoint and positive network timeout used by chrome-stop-loading.py.
# Outputs: none; this active configuration is read by chrome-stop-loading.py.
# Top-level entries: CHROME_CDP_HOST is a loopback hostname; CHROME_CDP_PORT is Chrome's debugging port; CHROME_CDP_TIMEOUT_SECONDS bounds each operation.
CHROME_CDP_HOST=127.0.0.1
CHROME_CDP_PORT=9222
CHROME_CDP_TIMEOUT_SECONDS=5
