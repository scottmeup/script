# jellyfin-library-pruner.env.example
# Inputs:
# - MOVIE_PATHS: colon-separated movie library roots. Each direct child is treated as one movie folder.
# - SHOW_PATHS: colon-separated show library roots. Each direct child is treated as one show folder.
# - TV_PATHS: backward-compatible alias for SHOW_PATHS when SHOW_PATHS is empty.
# - VIDEO_EXTENSIONS: playable media extensions without leading dots.
# - EPISODE_SIDECAREXTENSIONS: sidecar file extensions associated with episodes by basename.
# - TRICKPLAY_SUFFIX: suffix for Jellyfin trickplay directories.
# - THUMB_SUFFIX: suffix for episode thumbnail files before image extension.
# - SEASON_DIR_GLOB: find -name pattern for season directories under a show folder.
# - DELETE_MODE: false for dry run, true for deletion.
# - CREATE_FORCE_RESCAN: true to create FORCE_RESCAN_FILENAME markers in library roots and preserved media locations.
# - FORCE_RESCAN_FILENAME: rescan marker filename.
# Outputs:
# - This file is copied to .env and read by jellyfin-library-pruner.sh.
# - It does not create output by itself.

MOVIE_PATHS=/path/to/movies
SHOW_PATHS=/path/to/shows
VIDEO_EXTENSIONS=mkv mp4 avi mov m4v ts m2ts webm mpg mpeg wmv iso
EPISODE_SIDECAREXTENSIONS=srt ass sub idx vtt nfo jpg jpeg png webp
TRICKPLAY_SUFFIX=.trickplay
THUMB_SUFFIX=-thumb
SEASON_DIR_GLOB=Season *
DELETE_MODE=false
CREATE_FORCE_RESCAN=false
FORCE_RESCAN_FILENAME=.forcerescan
