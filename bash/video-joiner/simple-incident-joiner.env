# FILE: simple-incident-joiner.env
# ROLE: Active configuration for the standalone no-reencode incident joiner. Replace SOURCE_DIR and OUTPUT_DIR before use.
# INPUTS: SOURCE_DIR contains source clips. OUTPUT_DIR receives joined MP4 files. INCIDENT_GAP_SECONDS is the maximum gap from one clip end to the next clip start. ROTATION is 0, 90, 180, or 270 and is written as display metadata without re-encoding. EXTENSIONS is a comma-separated case-insensitive list.
# OUTPUTS: Controls incident grouping, output placement, filename prefix, supported source extensions, and optional rotation metadata.
SOURCE_DIR=/path/to/source/videos
OUTPUT_DIR=/path/to/joined/videos
INCIDENT_GAP_SECONDS=300
ROTATION=0
OUTPUT_PREFIX=incident
EXTENSIONS=.mp4,.mov,.m4v
