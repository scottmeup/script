# install file to
# /etc/freepbx-wanip-hosts/freepbx-tpg-sip-health.env
TPG_NODES=172.26.0.33 172.26.0.34 172.26.0.81 172.26.0.82
PCAP_DIR=/var/log/tpg-sip-pcap
STATE_DIR=/etc/freepbx-wanip-hosts/tpg-sip-health-state
LOOKBACK_SECONDS=3600
TCPDUMP=/usr/bin/tcpdump
MIN_GOOD_EVENTS=1
BAD_503_THRESHOLD=2
BAD_403_THRESHOLD=2
STALE_AFTER_SECONDS=3600
