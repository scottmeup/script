# Inputs used by install-freepbx-tpg-fresh.sh. Practical types: paths and strings. The target must already be a configured FreePBX 17 host with a working PJSIP registration named TPG-VoIP. SNMP_COMMUNITY is sensitive and must be supplied locally before installation.
TPG_HOST=uni-v1.tpg.com.au
TRUNK_NAME=TPG-VoIP
ROUTER_IP=192.168.1.1
WAN_IFNAME=ppp3
HOST_ALIAS=public.ip.address
SNMP_COMMUNITY=
TASMOTA_POWER_OFF_URL=http://192.168.1.204/cm?cmnd=Power%20off
ENABLE_ROUTER_POWER_CYCLE=yes
PCAP_DIR=/var/log/tpg-sip-pcap
STATE_ROOT=/etc/freepbx-wanip-hosts
