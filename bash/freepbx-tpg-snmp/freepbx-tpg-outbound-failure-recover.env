# install file to
# /etc/freepbx-wanip-hosts/freepbx-tpg-outbound-failure-recover.env
TRUNK_NAME=TPG-VoIP
SIP_ERROR_LOG=/var/log/tpg-sip-node-errors.log
STATE_DIR=/etc/freepbx-wanip-hosts/outbound-failure-state
OUTBOUND_FAILURE_WINDOW_SECONDS=600
OUTBOUND_FAILURE_MIN_COUNT=2
OUTBOUND_FAILURE_MIN_DISTINCT_CALLIDS=2
OUTBOUND_FAILURE_CODES=403 503 603
REGISTER_RECOVERY_COOLDOWN_SECONDS=900
REGISTRATION_RECOVERY_SCRIPT=/usr/local/sbin/freepbx-wanip-registration-recover
ROUTER_POWER_CYCLE_ENABLED=yes
ROUTER_POWER_CYCLE_MIN_COUNT=4
ROUTER_POWER_CYCLE_AFTER_REGISTER_RECOVERY_SECONDS=300
ROUTER_POWER_CYCLE_COOLDOWN_SECONDS=3600
ROUTER_IP=192.168.1.1
SNMP_COMMUNITY=YOUR_CURRENT_SNMP_COMMUNITY
WAN_IFNAME=ppp3
WAN_QUIET_RX_KBPS=256
WAN_QUIET_TX_KBPS=128
WAN_QUIET_SAMPLE_SECONDS=30
WAN_QUIET_REQUIRED_SAMPLES=4
TASMOTA_POWER_OFF_URL=http://192.168.1.204/cm?cmnd=Power%20off
CURL_MAX_TIME_SECONDS=10
