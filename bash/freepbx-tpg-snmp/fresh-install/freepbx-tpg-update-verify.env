# Inputs for the final accepted-state verifier. The verifier writes only its own reports and does not remediate failures automatically.
CHECKSUM_FILE=/etc/freepbx-wanip-hosts/freepbx-tpg-update-accepted.sha256
REPORT_TEXT=/etc/freepbx-wanip-hosts/tpg-update-verification/latest.txt
REPORT_JSON=/etc/freepbx-wanip-hosts/tpg-update-verification/latest.json
TPG_HOST=uni-v1.tpg.com.au
HOSTS_FILE=/etc/hosts
NODE_STATE_FILE=/etc/freepbx-wanip-hosts/tpg-node-state/node-state.json
POLICY_STATE_FILE=/etc/freepbx-wanip-hosts/tpg-node-policy/policy-state.json
EVENT_STATE_FILE=/etc/freepbx-wanip-hosts/tpg-node-event-watch/state.json
REQUIRED_ACTIVE_UNITS=freepbx-tpg-node-state.timer freepbx-tpg-node-policy.timer freepbx-tpg-node-event-watch.service freepbx-tpg-outbound-failure-recover.timer tpg-sip-error-monitor.service tpg-sip-pcap.service
REQUIRED_ENABLED_UNITS=freepbx-tpg-node-state.timer freepbx-tpg-node-policy.timer freepbx-tpg-node-event-watch.service freepbx-tpg-outbound-failure-recover.timer tpg-sip-error-monitor.service tpg-sip-pcap.service
REQUIRED_INACTIVE_UNITS=freepbx-tpg-sip-health-policy.timer freepbx-tpg-sip-health-policy-watch.service
ASTERISK_REGISTRATION_NAME=TPG-VoIP
COMMAND_TIMEOUT_SECONDS=20
ROOT_PREFIX=
COMMAND_PREFIX=
