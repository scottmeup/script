# Inputs for freepbx-tpg-router-reboot-recover. The SNMP uptime rollback identifies a router reboot. The script waits for TPG signalling readiness before forcing registration recovery.
ROUTER_IP=192.168.1.1
SNMP_COMMUNITY=DecafDisarm1Decibel
SNMPGET=/usr/bin/snmpget
ROUTER_UPTIME_OID=1.3.6.1.2.1.1.3.0
TRUNK_NAME=TPG-VoIP
SIP_HOST=uni-v1.tpg.com.au
SIP_PORT=5060
SIP_READY_TIMEOUT_SECONDS=2
ROUTER_REBOOT_STATE_FILE=/etc/freepbx-wanip-hosts/router-reboot-recovery-state.json
ROUTER_REBOOT_MIN_DROP_TICKS=3000
ROUTER_REBOOT_RECOVERY_COOLDOWN_SECONDS=300
ROUTER_REBOOT_WAIT_TIMEOUT_SECONDS=300
ROUTER_REBOOT_WAIT_INTERVAL_SECONDS=5
REGISTRATION_RECOVERY_SCRIPT=/usr/local/sbin/freepbx-wanip-registration-recover
