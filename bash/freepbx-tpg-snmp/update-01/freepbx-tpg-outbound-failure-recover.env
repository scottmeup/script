# Staged recovery: repeated configured failures trigger forced REGISTER, then PJSIP reload plus REGISTER, then guarded router power cycling if no configured success occurs.
TRUNK_NAME=TPG-VoIP
SIP_ERROR_LOG=/var/log/tpg-sip-node-errors.log
STATE_DIR=/etc/freepbx-wanip-hosts/outbound-failure-state
PCAP_DIR=/var/log/tpg-sip-pcap
SIP_HEALTH_JSON=/etc/freepbx-wanip-hosts/tpg-sip-health-state/sip-health.json
TCPDUMP=/usr/bin/tcpdump
OUTBOUND_FAILURE_WINDOW_SECONDS=600
OUTBOUND_FAILURE_MIN_COUNT=2
OUTBOUND_FAILURE_MIN_DISTINCT_CALLIDS=2
OUTBOUND_FAILURE_CODES=403 503 603
OUTBOUND_SUCCESS_WINDOW_SECONDS=600
OUTBOUND_SUCCESS_CODES=180 183 200
OUTBOUND_SUCCESS_PCAP_LOOKBACK_FILES=180
REGISTER_RECOVERY_COOLDOWN_SECONDS=300
PJSIP_RELOAD_AFTER_FIRST_RECOVERY_SECONDS=300
PJSIP_RELOAD_SETTLE_SECONDS=5
REGISTRATION_RECOVERY_SCRIPT=/usr/local/sbin/freepbx-wanip-registration-recover
ROUTER_POWER_CYCLE_ENABLED=yes
ROUTER_POWER_CYCLE_AFTER_FIRST_REGISTER_RECOVERY_SECONDS=900
ROUTER_POWER_CYCLE_COOLDOWN_SECONDS=3600
ROUTER_IP=192.168.1.1
SNMP_COMMUNITY=DecafDisarm1Decibel
WAN_IFNAME=ppp3
WAN_QUIET_RX_KBPS=256
WAN_QUIET_TX_KBPS=128
WAN_QUIET_SAMPLE_SECONDS=30
WAN_QUIET_REQUIRED_SAMPLES=4
TASMOTA_POWER_OFF_URL=http://192.168.1.204/cm?cmnd=Power%20off
CURL_MAX_TIME_SECONDS=10
