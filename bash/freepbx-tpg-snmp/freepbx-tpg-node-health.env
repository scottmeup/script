# install this file to:
# /etc/freepbx-wanip-hosts/freepbx-tpg-node-health.env
TPG_HOST=uni-v1.tpg.com.au
DNS_SERVER=192.168.1.20
TRUNK_NAME=TPG-VoIP
HOSTS_FILE=/etc/hosts
STATE_DIR=/etc/freepbx-wanip-hosts/tpg-node-health-state
MIN_GOOD_NODES=2
MAX_SELECTED_NODES=2
PING_COUNT=5
PING_TIMEOUT_SECONDS=1
MIN_PING_SUCCESS=3
MAX_AVG_RTT_MS=150
BACKUP_KEEP=10
REFRESH_ASTERISK_AFTER_NODE_CHANGE=yes
ASTERISK_RESTART_CALL_CHECK_INTERVAL_SECONDS=5
ASTERISK_RESTART_WAIT_TIMEOUT_SECONDS=0
REGISTRATION_RECOVER=/usr/local/sbin/freepbx-wanip-registration-recover