# Input configuration for freepbx-tpg-node-state. Each health-evidence condition acts independently. Default call-health evidence is an INVITE 200 response. Successful registration does not imply healthy by default. Active-call protection uses the whole trunk until per-node concurrent-call attribution is proven.
TPG_HOST=uni-v1.tpg.com.au
TRUNK_NAME=TPG-VoIP
SIP_HEALTH_JSON=/etc/freepbx-wanip-hosts/tpg-sip-health-state/sip-health.json
PCAP_DIR=/var/log/tpg-sip-pcap
SIP_ERROR_LOG=/var/log/tpg-sip-node-errors.log
TCPDUMP=/usr/bin/tcpdump
STATE_FILE=/etc/freepbx-wanip-hosts/tpg-node-state/node-state.json
SUMMARY_FILE=/etc/freepbx-wanip-hosts/tpg-node-state/node-state-summary.txt
LOCK_FILE=/run/freepbx-tpg-node-state.lock
LOG_TAG=freepbx-tpg-node-state
LOOKBACK_SECONDS=86400
PCAP_LOOKBACK_FILES=600
HEALTH_EVIDENCE_INVITE_CODES=200
HEALTH_EVIDENCE_ACTIVE_CALL=yes
HEALTH_EVIDENCE_SUCCESSFUL_REGISTRATION=no
REGISTRATION_SUCCESS_CODES=200
NODE_FAILURE_INVITE_CODES=403 408 500 502 503 504
NODE_FAILURE_REGISTER_CODES=403 408 500 502 503 504
NODE_FAILURE_INVITE_MIN_DISTINCT_CALLIDS=2
NODE_FAILURE_REGISTER_MIN_DISTINCT_CALLIDS=1
FAILURE_WINDOW_SECONDS=86400
ACTIVE_CALL_PROTECTION_SCOPE=trunk
RESET_WHEN_ALL_UNHEALTHY=yes
