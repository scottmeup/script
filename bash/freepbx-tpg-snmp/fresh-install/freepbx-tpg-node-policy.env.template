# Input configuration for the sticky single-node policy. Persistent node state is the only health authority. Ping is intentionally absent. Exactly one healthy or un-errored node is selected. Registration recovery runs only after a real node change.
TPG_HOST=uni-v1.tpg.com.au
TRUNK_NAME=TPG-VoIP
NODE_STATE_FILE=/etc/freepbx-wanip-hosts/tpg-node-state/node-state.json
HOSTS_FILE=/etc/hosts
STATE_FILE=/etc/freepbx-wanip-hosts/tpg-node-policy/policy-state.json
BACKUP_DIR=/etc/freepbx-wanip-hosts/tpg-node-policy/hosts-backups
LOCK_FILE=/run/freepbx-tpg-node-policy.lock
LOG_TAG=freepbx-tpg-node-policy
REGISTRATION_RECOVERY_SCRIPT=/usr/local/sbin/freepbx-wanip-registration-recover
RUN_REGISTRATION_RECOVERY_ON_CHANGE=yes
REGISTRATION_RECOVERY_TIMEOUT_SECONDS=360
REQUIRE_ELIGIBLE_NODE=yes
DRY_RUN=no
