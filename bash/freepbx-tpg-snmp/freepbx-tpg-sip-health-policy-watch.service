# install file to 
# /etc/systemd/system/freepbx-tpg-sip-health-policy-watch.service

[Unit]
Description=Watch completed TPG SIP pcaps and trigger SIP health policy
After=network-online.target tpg-sip-pcap.service
Wants=network-online.target tpg-sip-pcap.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -x /usr/bin/inotifywait
ExecStartPre=/usr/bin/test -x /usr/local/sbin/freepbx-tpg-sip-health-policy
ExecStart=/usr/local/sbin/freepbx-tpg-sip-health-policy-watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
