#!/usr/bin/env bash

# save this file to
# /usr/local/sbin/freepbx-tpg-node-health-update

set -euo pipefail

ENV_FILE="${ENV_FILE:-/etc/freepbx-wanip-hosts/freepbx-tpg-node-health.env}"

if [ ! -r "$ENV_FILE" ]; then
  logger -t freepbx-tpg-node-health "environment file not readable: $ENV_FILE"
  exit 10
fi

. "$ENV_FILE"

TPG_HOST="${TPG_HOST:?TPG_HOST is required}"
DNS_SERVER="${DNS_SERVER:?DNS_SERVER is required}"
TRUNK_NAME="${TRUNK_NAME:?TRUNK_NAME is required}"
HOSTS_FILE="${HOSTS_FILE:-/etc/hosts}"
STATE_DIR="${STATE_DIR:-/etc/freepbx-wanip-hosts/tpg-node-health-state}"
MIN_GOOD_NODES="${MIN_GOOD_NODES:-2}"
MAX_SELECTED_NODES="${MAX_SELECTED_NODES:-2}"
PING_COUNT="${PING_COUNT:-5}"
PING_TIMEOUT_SECONDS="${PING_TIMEOUT_SECONDS:-1}"
MIN_PING_SUCCESS="${MIN_PING_SUCCESS:-3}"
MAX_AVG_RTT_MS="${MAX_AVG_RTT_MS:-150}"
BACKUP_KEEP="${BACKUP_KEEP:-10}"
REFRESH_ASTERISK_AFTER_NODE_CHANGE="${REFRESH_ASTERISK_AFTER_NODE_CHANGE:-yes}"
ASTERISK_RESTART_CALL_CHECK_INTERVAL_SECONDS="${ASTERISK_RESTART_CALL_CHECK_INTERVAL_SECONDS:-5}"
ASTERISK_RESTART_WAIT_TIMEOUT_SECONDS="${ASTERISK_RESTART_WAIT_TIMEOUT_SECONDS:-0}"
REGISTRATION_RECOVER="${REGISTRATION_RECOVER:-/usr/local/sbin/freepbx-wanip-registration-recover}"

LOCK_FILE="/run/freepbx-tpg-node-health-update.lock"
RECOVERY_LOCK_FILE="/run/freepbx-wanip-registration-recover.lock"
LAST_WORKING_HOSTS="$STATE_DIR/hosts.last-known-working"
LAST_WORKING_NODES="$STATE_DIR/nodes.last-known-working"
CURRENT_HEALTH="$STATE_DIR/node-health.tsv"
MANAGED_BEGIN="# BEGIN FREEPBX-TPG-NODE-HEALTH"
MANAGED_END="# END FREEPBX-TPG-NODE-HEALTH"

exec 6>"$LOCK_FILE"
flock -n 6 || exit 0

mkdir -p "$STATE_DIR"

log_msg() {
  logger -t freepbx-tpg-node-health "$1"
}

registration_recovery_active() {
  ! ( flock -n 98 ) 98>"$RECOVERY_LOCK_FILE"
}

check_no_recovery_active_or_defer() {
  if registration_recovery_active; then
    log_msg "registration recovery already running; deferring node health update"
    exit 75
  fi
}

trunk_call_active() {
  asterisk -rx "core show channels concise" 2>/dev/null |
    grep -F "PJSIP/${TRUNK_NAME}-" >/dev/null
}

wait_for_no_trunk_calls() {
  start_epoch="$(date +%s)"

  while trunk_call_active; do
    if [ "$ASTERISK_RESTART_WAIT_TIMEOUT_SECONDS" -gt 0 ]; then
      now_epoch="$(date +%s)"
      elapsed="$((now_epoch - start_epoch))"

      if [ "$elapsed" -ge "$ASTERISK_RESTART_WAIT_TIMEOUT_SECONDS" ]; then
        log_msg "restart deferred timeout reached while $TRUNK_NAME trunk calls are still active"
        return 1
      fi
    fi

    log_msg "$TRUNK_NAME trunk call active; delaying Asterisk restart"
    sleep "$ASTERISK_RESTART_CALL_CHECK_INTERVAL_SECONDS"
  done

  return 0
}

resolve_dns_nodes() {
  dig @"$DNS_SERVER" +short "$TPG_HOST" A |
    awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print }' |
    sort -u
}

probe_node() {
  ip="$1"
  output="$(ping -n -c "$PING_COUNT" -W "$PING_TIMEOUT_SECONDS" "$ip" 2>&1 || true)"

  received="$(
    printf '%s\n' "$output" |
      awk -F',' '/packets transmitted/ {
        gsub(/[^0-9]/, "", $2)
        print $2
        exit
      }'
  )"

  avg="$(
    printf '%s\n' "$output" |
      awk -F'=' '/^rtt/ {
        split($2, a, "/")
        gsub(/^[ \t]+/, "", a[2])
        print a[2]
        exit
      }'
  )"

  received="${received:-0}"
  avg="${avg:-999999}"

  if [ "$received" -ge "$MIN_PING_SUCCESS" ] &&
     awk -v avg="$avg" -v max="$MAX_AVG_RTT_MS" 'BEGIN { exit avg <= max ? 0 : 1 }'; then
    status="healthy"
  else
    status="unhealthy"
  fi

  printf '%s\t%s\t%s\t%s\n' "$ip" "$status" "$received" "$avg"
}

node_in_list() {
  needle="$1"
  shift

  for item in "$@"; do
    if [ "$item" = "$needle" ]; then
      return 0
    fi
  done

  return 1
}

build_candidate_nodes() {
  health_file="$1"
  result_file="$2"
  tmpfile="$(mktemp)"
  : > "$tmpfile"

  selected=()

  if [ -r "$LAST_WORKING_NODES" ]; then
    while read -r ip; do
      [ -n "$ip" ] || continue
      if awk -v ip="$ip" '$1 == ip && $2 == "healthy" { found = 1 } END { exit found ? 0 : 1 }' "$health_file"; then
        if ! node_in_list "$ip" "${selected[@]:-}"; then
          selected+=("$ip")
        fi
      fi
    done < "$LAST_WORKING_NODES"
  fi

  while read -r ip; do
    [ -n "$ip" ] || continue

    if ! node_in_list "$ip" "${selected[@]:-}"; then
      selected+=("$ip")
    fi

    if [ "${#selected[@]}" -ge "$MAX_SELECTED_NODES" ]; then
      break
    fi
  done < <(awk '$2 == "healthy" { print $1, $4 }' "$health_file" | sort -k2,2n | awk '{ print $1 }')

  if [ "${#selected[@]}" -lt "$MIN_GOOD_NODES" ]; then
    rm -f "$tmpfile"
    return 1
  fi

  for ip in "${selected[@]}"; do
    printf '%s\n' "$ip" >> "$tmpfile"
  done

  mv "$tmpfile" "$result_file"
  return 0
}

current_hosts_nodes() {
  awk -v host="$TPG_HOST" '
    /^[[:space:]]*#/ { next }
    {
      for (i = 2; i <= NF; i++) {
        if ($i == host) {
          print $1
        }
      }
    }
  ' "$HOSTS_FILE"
}

nodes_equal_current() {
  candidate_file="$1"
  current_file="$(mktemp)"

  current_hosts_nodes > "$current_file"

  if cmp -s "$candidate_file" "$current_file"; then
    rm -f "$current_file"
    return 0
  fi

  rm -f "$current_file"
  return 1
}

backup_hosts() {
  ts="$(date +%Y%m%d-%H%M%S)"
  cp -a "$HOSTS_FILE" "$STATE_DIR/hosts.$ts.bak"

  find "$STATE_DIR" -maxdepth 1 -type f -name 'hosts.*.bak' |
    sort |
    head -n "-$BACKUP_KEEP" |
    xargs -r rm -f
}

apply_nodes_to_hosts() {
  nodes_file="$1"
  tmpfile="$(mktemp)"

  awk -v host="$TPG_HOST" -v begin="$MANAGED_BEGIN" -v end="$MANAGED_END" '
    $0 == begin {
      in_block = 1
      next
    }
    $0 == end {
      in_block = 0
      next
    }
    in_block {
      next
    }
    /^[[:space:]]*#/ {
      print
      next
    }
    {
      keep = 1
      for (i = 2; i <= NF; i++) {
        if ($i == host) {
          keep = 0
        }
      }
      if (keep) {
        print
      }
    }
  ' "$HOSTS_FILE" > "$tmpfile"

  {
    cat "$tmpfile"
    printf '%s\n' "$MANAGED_BEGIN"
    while read -r ip; do
      [ -n "$ip" ] || continue
      printf '%s %s\n' "$ip" "$TPG_HOST"
    done < "$nodes_file"
    printf '%s\n' "$MANAGED_END"
  } > "$HOSTS_FILE"

  rm -f "$tmpfile"
}

run_non_disruptive_recovery() {
  if registration_recovery_active; then
    log_msg "registration recovery already running; not starting another recovery"
    return 75
  fi

  ASTERISK_RESTART_ON_REGISTRATION_FAILURE=no "$REGISTRATION_RECOVER"
}

refresh_asterisk_if_enabled() {
  if [ "$REFRESH_ASTERISK_AFTER_NODE_CHANGE" != "yes" ]; then
    return 0
  fi

  if registration_recovery_active; then
    log_msg "registration recovery already running; not restarting Asterisk"
    return 75
  fi

  if ! wait_for_no_trunk_calls; then
    return 1
  fi

  log_msg "restarting Asterisk to refresh runtime SIP resolver state"
  systemctl restart asterisk
  sleep 5
  return 0
}

validate_after_change() {
  if registration_recovery_active; then
    log_msg "registration recovery already running; validation deferred"
    return 75
  fi

  if run_non_disruptive_recovery; then
    if refresh_asterisk_if_enabled; then
      run_non_disruptive_recovery
      return "$?"
    fi

    return 0
  fi

  rc="$?"

  if [ "$rc" -eq 75 ]; then
    return 75
  fi

  if refresh_asterisk_if_enabled; then
    run_non_disruptive_recovery
    return "$?"
  fi

  return 1
}

save_last_known_working() {
  nodes_file="$1"
  cp -a "$HOSTS_FILE" "$LAST_WORKING_HOSTS"
  cp -a "$nodes_file" "$LAST_WORKING_NODES"
}

apply_and_validate_candidate() {
  label="$1"
  nodes_file="$2"

  if registration_recovery_active; then
    log_msg "registration recovery already running; not applying $label nodes"
    return 75
  fi

  backup_hosts
  apply_nodes_to_hosts "$nodes_file"

  log_msg "applied $label nodes for $TPG_HOST: $(tr '\n' ' ' < "$nodes_file")"

  if validate_after_change; then
    save_last_known_working "$nodes_file"
    log_msg "$label nodes validated and saved as last known working"
    return 0
  fi

  rc="$?"

  if [ "$rc" -eq 75 ]; then
    log_msg "$label nodes validation deferred because registration recovery is already running"
    return 75
  fi

  log_msg "$label nodes failed registration validation"
  return 1
}

restore_last_known_working() {
  if registration_recovery_active; then
    log_msg "registration recovery already running; not restoring last known working hosts"
    return 75
  fi

  if [ ! -r "$LAST_WORKING_HOSTS" ] || [ ! -r "$LAST_WORKING_NODES" ]; then
    return 1
  fi

  backup_hosts
  cp -a "$LAST_WORKING_HOSTS" "$HOSTS_FILE"

  log_msg "restored last known working hosts for $TPG_HOST"

  validate_after_change
}

check_no_recovery_active_or_defer

dns_nodes_file="$(mktemp)"
health_file="$(mktemp)"
candidate_file="$(mktemp)"
fallback_file="$(mktemp)"

cleanup() {
  rm -f "$dns_nodes_file" "$health_file" "$candidate_file" "$fallback_file"
}

trap cleanup EXIT

resolve_dns_nodes > "$dns_nodes_file"

if [ ! -s "$dns_nodes_file" ]; then
  log_msg "no DNS A records found for $TPG_HOST via $DNS_SERVER"
  exit 20
fi

while read -r ip; do
  [ -n "$ip" ] || continue
  probe_node "$ip" >> "$health_file"
done < "$dns_nodes_file"

cp -a "$health_file" "$CURRENT_HEALTH"

if build_candidate_nodes "$health_file" "$candidate_file"; then
  :
else
  cp -a "$dns_nodes_file" "$candidate_file"
  log_msg "insufficient healthy nodes; using live DNS fallback candidate"
fi

if nodes_equal_current "$candidate_file"; then
  log_msg "node set unchanged for $TPG_HOST"
  exit 0
fi

if registration_recovery_active; then
  log_msg "registration recovery already running; not changing node set"
  exit 75
fi

if apply_and_validate_candidate "candidate" "$candidate_file"; then
  exit 0
fi

rc="$?"

if [ "$rc" -eq 75 ]; then
  exit 75
fi

if restore_last_known_working; then
  log_msg "last known working restore succeeded"
  exit 0
fi

rc="$?"

if [ "$rc" -eq 75 ]; then
  exit 75
fi

cp -a "$dns_nodes_file" "$fallback_file"

if apply_and_validate_candidate "live DNS fallback" "$fallback_file"; then
  exit 0
fi

rc="$?"

if [ "$rc" -eq 75 ]; then
  exit 75
fi

log_msg "live DNS fallback applied but registration validation failed; leaving live DNS fallback in place"
exit 30