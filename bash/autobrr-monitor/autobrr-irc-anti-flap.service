# File: autobrr-irc-anti-flap.service
# Project role: systemd supervision for autobrr-irc-anti-flap.sh.
# Direct inputs:
# - docker.service and network-online.target: ordering dependencies used by systemd.
# - /usr/local/sbin/autobrr-irc-anti-flap.sh: executable main entrypoint.
# - /etc/autobrr-irc-anti-flap.env: dotenv path passed through AUTOBRR_ANTI_FLAP_ENV.
# Direct outputs and side effects:
# - Starts one persistent watchdog process and captures its stdout/stderr in journald.
# - Restarts only the watchdog process when it exits unsuccessfully.
# - Allows writes to the state directory and /run while applying filesystem hardening.
# Cross-file flow: invokes the shell script, which sources the env file; operational details are in README.md.

[Unit]
Description=autobrr IRC anti-flap watchdog
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Environment=AUTOBRR_ANTI_FLAP_ENV=/etc/autobrr-irc-anti-flap.env
ExecStart=/usr/local/sbin/autobrr-irc-anti-flap.sh
Restart=on-failure
RestartSec=10s
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/autobrr-irc-anti-flap /run

[Install]
WantedBy=multi-user.target
