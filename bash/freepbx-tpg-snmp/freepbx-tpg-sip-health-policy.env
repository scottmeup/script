# install files to
# /etc/freepbx-wanip-hosts/freepbx-tpg-sip-health-policy.env
TPG_HOST=uni-v1.tpg.com.au
HOSTS_FILE=/etc/hosts
STATE_DIR=/etc/freepbx-wanip-hosts/tpg-sip-health-state
HEALTH_CHECK=/usr/local/sbin/freepbx-tpg-sip-health-check
HEALTH_JSON=/etc/freepbx-wanip-hosts/tpg-sip-health-state/sip-health.json
SELECT_STATES=healthy mixed
PING_PROBE_ENABLED=yes
PING_COUNT=2
PING_TIMEOUT_SECONDS=1
PING_MIN_SUCCESS=1
PING_FILTER_SELECTED_NODES=yes
REFRESH_ASTERISK_AFTER_POLICY_CHANGE=no
TRUNK_NAME=TPG-VoIP
BACKUP_KEEP=20
