# - JELLYFIN_CONFIG_DIR: required path to Jellyfin's configuration/data root.
# - BACKUP_OUTPUT_DIR: required path where backup archives and checksum files are written. This directory is created if it does not exist.
# - BACKUP_NAME_PREFIX: optional archive filename prefix.
# - STOP_JELLYFIN_COMMAND: optional command run before backup to stop Jellyfin for database consistency.
# - START_JELLYFIN_COMMAND: optional command run after backup to restart Jellyfin.
# - REQUIRE_STOP: optional 1/0 flag. Set to 1 to abort unless STOP_JELLYFIN_COMMAND is provided and succeeds.
# - DRY_RUN: optional 1/0 flag. Set to 1 to list files without creating an archive.
# - INCLUDE_PLUGIN_CONFIGS: optional 1/0 flag. Set to 1 to include plugin configuration files under plugins/configurations.
# - EXTRA_INCLUDE_PATHS: optional colon-separated relative paths under JELLYFIN_CONFIG_DIR to include. Metadata/cache/log/transcode/temp paths are always skipped.
# Outputs a .tar.gz backup archive and .sha256 checksum file in BACKUP_OUTPUT_DIR when DRY_RUN=0.

JELLYFIN_CONFIG_DIR=/path/to/jellyfin/config
BACKUP_OUTPUT_DIR=/path/to/backups/jellyfin
BACKUP_NAME_PREFIX=jellyfin-backup
STOP_JELLYFIN_COMMAND='sudo systemctl stop jellyfin'
START_JELLYFIN_COMMAND='sudo systemctl start jellyfin'
REQUIRE_STOP=1
DRY_RUN=0
INCLUDE_PLUGIN_CONFIGS=1
EXTRA_INCLUDE_PATHS=
