#!/usr/bin/env bash
set -euo pipefail

SRC_DIR="${SOURCE_DIR:-$(pwd -P)}"
ETC_DIR="/etc/freepbx-wanip-hosts"
SBIN_DIR="/usr/local/sbin"
SYSTEMD_DIR="/etc/systemd/system"
PCAP_DIR="/var/log/tpg-sip-pcap"

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: run as root" >&2
  exit 1
fi

required_files=(
  freepbx-wanip-hosts-update
  freepbx-wanip-registration-recover
  freepbx-wanip-registration-watchdog
  freepbx-tpg-router-powercycle-guard
  freepbx-tpg-sip-health-check
  tpg-sip-error-monitor
  freepbx-wanip-hosts.env
  freepbx-tpg-router-powercycle.env
  freepbx-tpg-sip-health.env
  freepbx-wanip-hosts-update.service
  freepbx-wanip-hosts-update.timer
  freepbx-wanip-registration-watchdog.service
  freepbx-wanip-registration-watchdog.timer
  freepbx-tpg-router-powercycle-guard.service
  freepbx-tpg-router-powercycle-guard.timer
  freepbx-tpg-sip-health-check.service
  freepbx-tpg-sip-health-check.timer
  tpg-sip-pcap.service
  tpg-sip-error-monitor.service
)

optional_files=(
  freepbx-tpg-node-health-update
  freepbx-tpg-node-health.env
  freepbx-tpg-node-health-update.service
  freepbx-tpg-node-health-update.timer
)

missing=()
for file in "${required_files[@]}"; do
  if [ ! -f "$SRC_DIR/$file" ]; then
    missing+=("$file")
  fi
done

if [ "${#missing[@]}" -gt 0 ]; then
  echo "ERROR: installation halted. Missing required files in $SRC_DIR:" >&2
  for file in "${missing[@]}"; do
    echo "  $file" >&2
  done
  exit 20
fi

prompt_value() {
  variable_name="$1"
  prompt_text="$2"
  default_value="$3"
  value=""
  if [ -n "$default_value" ]; then
    read -r -p "$prompt_text [$default_value]: " value
    value="${value:-$default_value}"
  else
    while [ -z "$value" ]; do
      read -r -p "$prompt_text: " value
    done
  fi
  printf '%s\n' "$value"
}

read_env_value() {
  file="$1"
  key="$2"
  if [ -r "$file" ]; then
    awk -F= -v key="$key" '$1 == key { print substr($0, index($0, "=") + 1); exit }' "$file"
  fi
}

set_env_value() {
  file="$1"
  key="$2"
  value="$3"
  escaped_value="$(printf '%s' "$value" | sed 's/[&/]/\\&/g')"
  if grep -q "^${key}=" "$file"; then
    sed -i "s/^${key}=.*/${key}=${escaped_value}/" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
}

existing_router_ip="$(read_env_value "$ETC_DIR/freepbx-wanip-hosts.env" ROUTER_IP || true)"
existing_snmp="$(read_env_value "$ETC_DIR/freepbx-wanip-hosts.env" SNMP_COMMUNITY || true)"
existing_plug_url="$(read_env_value "$ETC_DIR/freepbx-tpg-router-powercycle.env" TASMOTA_POWER_OFF_URL || true)"
existing_plug_ip=""
if [ -n "$existing_plug_url" ]; then
  existing_plug_ip="$(printf '%s\n' "$existing_plug_url" | sed -n 's#^http://\([^/:]*\).*#\1#p')"
fi

if [ -z "$existing_router_ip" ]; then
  existing_router_ip="192.168.1.1"
fi
if [ -z "$existing_plug_ip" ]; then
  existing_plug_ip="192.168.1.204"
fi
if [ -z "$existing_snmp" ] || [ "$existing_snmp" = "YOUR_CURRENT_SNMP_COMMUNITY" ]; then
  existing_snmp=""
fi

router_ip="$(prompt_value ROUTER_IP "Router IP address" "$existing_router_ip")"
snmp_community="$(prompt_value SNMP_COMMUNITY "SNMP community string" "$existing_snmp")"
smart_plug_ip="$(prompt_value SMART_PLUG_IP "Tasmota smart plug IP address" "$existing_plug_ip")"

mkdir -p "$ETC_DIR" "$SBIN_DIR" "$SYSTEMD_DIR" "$PCAP_DIR" \
  "$ETC_DIR/tpg-sip-health-state" \
  "$ETC_DIR/router-powercycle-state" \
  "$ETC_DIR/tpg-node-health-state"

install -o root -g root -m 750 "$SRC_DIR/freepbx-wanip-hosts-update" "$SBIN_DIR/freepbx-wanip-hosts-update"
install -o root -g root -m 750 "$SRC_DIR/freepbx-wanip-registration-recover" "$SBIN_DIR/freepbx-wanip-registration-recover"
install -o root -g root -m 750 "$SRC_DIR/freepbx-wanip-registration-watchdog" "$SBIN_DIR/freepbx-wanip-registration-watchdog"
install -o root -g root -m 750 "$SRC_DIR/freepbx-tpg-router-powercycle-guard" "$SBIN_DIR/freepbx-tpg-router-powercycle-guard"
install -o root -g root -m 750 "$SRC_DIR/freepbx-tpg-sip-health-check" "$SBIN_DIR/freepbx-tpg-sip-health-check"
install -o root -g root -m 750 "$SRC_DIR/tpg-sip-error-monitor" "$SBIN_DIR/tpg-sip-error-monitor"

install -o root -g root -m 640 "$SRC_DIR/freepbx-wanip-hosts.env" "$ETC_DIR/freepbx-wanip-hosts.env"
install -o root -g root -m 640 "$SRC_DIR/freepbx-tpg-router-powercycle.env" "$ETC_DIR/freepbx-tpg-router-powercycle.env"
install -o root -g root -m 640 "$SRC_DIR/freepbx-tpg-sip-health.env" "$ETC_DIR/freepbx-tpg-sip-health.env"

for file in \
  freepbx-wanip-hosts-update.service \
  freepbx-wanip-hosts-update.timer \
  freepbx-wanip-registration-watchdog.service \
  freepbx-wanip-registration-watchdog.timer \
  freepbx-tpg-router-powercycle-guard.service \
  freepbx-tpg-router-powercycle-guard.timer \
  freepbx-tpg-sip-health-check.service \
  freepbx-tpg-sip-health-check.timer \
  tpg-sip-pcap.service \
  tpg-sip-error-monitor.service; do
  install -o root -g root -m 644 "$SRC_DIR/$file" "$SYSTEMD_DIR/$file"
done

for file in "${optional_files[@]}"; do
  if [ -f "$SRC_DIR/$file" ]; then
    case "$file" in
      *.service|*.timer)
        install -o root -g root -m 644 "$SRC_DIR/$file" "$SYSTEMD_DIR/$file"
        ;;
      *.env)
        install -o root -g root -m 640 "$SRC_DIR/$file" "$ETC_DIR/$file"
        ;;
      *)
        install -o root -g root -m 750 "$SRC_DIR/$file" "$SBIN_DIR/$file"
        ;;
    esac
  fi
done

set_env_value "$ETC_DIR/freepbx-wanip-hosts.env" ROUTER_IP "$router_ip"
set_env_value "$ETC_DIR/freepbx-wanip-hosts.env" SNMP_COMMUNITY "$snmp_community"
set_env_value "$ETC_DIR/freepbx-tpg-router-powercycle.env" ROUTER_IP "$router_ip"
set_env_value "$ETC_DIR/freepbx-tpg-router-powercycle.env" SNMP_COMMUNITY "$snmp_community"
set_env_value "$ETC_DIR/freepbx-tpg-router-powercycle.env" TASMOTA_POWER_OFF_URL "http://${smart_plug_ip}/cm?cmnd=Power%20off"

if grep -q '^DNS_SERVER=$' "$ETC_DIR/freepbx-tpg-sip-health.env"; then
  set_env_value "$ETC_DIR/freepbx-tpg-sip-health.env" DNS_SERVER "$router_ip"
fi

if getent group tcpdump >/dev/null; then
  chown root:tcpdump "$PCAP_DIR"
  chmod 2770 "$PCAP_DIR"
else
  chown root:adm "$PCAP_DIR"
  chmod 2770 "$PCAP_DIR"
fi

chmod 750 "$SBIN_DIR/freepbx-wanip-hosts-update" \
  "$SBIN_DIR/freepbx-wanip-registration-recover" \
  "$SBIN_DIR/freepbx-wanip-registration-watchdog" \
  "$SBIN_DIR/freepbx-tpg-router-powercycle-guard" \
  "$SBIN_DIR/freepbx-tpg-sip-health-check" \
  "$SBIN_DIR/tpg-sip-error-monitor"

bash -n "$SBIN_DIR/freepbx-wanip-hosts-update"
bash -n "$SBIN_DIR/freepbx-wanip-registration-recover"
bash -n "$SBIN_DIR/freepbx-wanip-registration-watchdog"
bash -n "$SBIN_DIR/freepbx-tpg-router-powercycle-guard"
bash -n "$SBIN_DIR/tpg-sip-error-monitor"
python3 -m py_compile "$SBIN_DIR/freepbx-tpg-sip-health-check"

systemctl daemon-reload

systemctl enable --now tpg-sip-pcap.service
systemctl enable --now tpg-sip-error-monitor.service
systemctl enable --now freepbx-wanip-hosts-update.timer
systemctl enable --now freepbx-wanip-registration-watchdog.timer
systemctl enable --now freepbx-tpg-router-powercycle-guard.timer
systemctl enable --now freepbx-tpg-sip-health-check.timer

systemctl disable --now freepbx-tpg-node-health-update.timer >/dev/null 2>&1 || true

"$SBIN_DIR/freepbx-tpg-sip-health-check" >/dev/null
"$SBIN_DIR/freepbx-tpg-router-powercycle-guard" >/dev/null || true

cat <<REPORT
Install completed.

Installed from: $SRC_DIR
Router IP: $router_ip
Tasmota plug IP: $smart_plug_ip

Enabled and started:
  tpg-sip-pcap.service
  tpg-sip-error-monitor.service
  freepbx-wanip-hosts-update.timer
  freepbx-wanip-registration-watchdog.timer
  freepbx-tpg-router-powercycle-guard.timer
  freepbx-tpg-sip-health-check.timer

Disabled:
  freepbx-tpg-node-health-update.timer

Check status:
  systemctl status tpg-sip-pcap.service -l --no-pager
  systemctl status tpg-sip-error-monitor.service -l --no-pager
  systemctl status freepbx-wanip-hosts-update.timer -l --no-pager
  systemctl status freepbx-wanip-registration-watchdog.timer -l --no-pager
  systemctl status freepbx-tpg-router-powercycle-guard.timer -l --no-pager
  systemctl status freepbx-tpg-sip-health-check.timer -l --no-pager

SIP health summary:
  cat /etc/freepbx-wanip-hosts/tpg-sip-health-state/sip-health-summary.txt
REPORT
